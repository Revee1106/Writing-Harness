{
  "name": "short-story-first-writing-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Short-story-first Writing Harness v0.1 — 短篇优先写作 Harness",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "harness": "node src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures:check": "node scripts/refresh-recorded-fixtures.ts",
    "fixtures:refresh": "node scripts/refresh-recorded-fixtures.ts --write"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
